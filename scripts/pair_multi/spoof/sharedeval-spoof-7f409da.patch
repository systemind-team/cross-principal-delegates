+  PACT_PAIR_SPOOF_PREFIX_IDS_V1,
+  loadPactPairSpoofPrefixV1,
+} from '../../src/suites/pact-pair/spoof.js';
+import { loadPactPairTasksV1 } from '../../src/suites/pact-pair/task-loader.js';
+
+const repositoryRoot = join(import.meta.dirname, '..', '..');
+
+// ---------------------------------------------------------------------------
+// Configuration
+
+function configYaml(spoof = ''): string {
+  return `
+apiVersion: sharedeval-run/v2
+kind: RunConfig
+model:
+  provider: openai-compatible
+  baseUrl: https://api.example.com/v1
+  apiKeyEnv: SHAREDEVAL_MODEL_API_KEY
+  model: example-model
+workflow:
+  mode: multi
+  protocol: files
+  maxTicks: 22
+  stopWhen: all-terminal
+  pairProfile: simple
+benchmark:
+  dataset: pact-pair
+  policy: D2R_ID_R0
+  requester: R0
+  gradingMode: relationship
+  tasks:
+    kind: all
+    ids: [PAIR-Q72, PAIR-Q258, PAIR-A100]
+${spoof}`;
+}
+
+test('a config without the spoof block parses and digests exactly as before', () => {
+  const effective = applySharedevalOverridesV1(
+    parseSharedevalRunConfigYaml(configYaml()),
+    resolveWorkflow(['multi']),
+  );
+  assert.equal('spoof' in effective.benchmark, false);
+  // The digest is canonical JSON over the effective config; an absent optional
+  // block adds no key, so it cannot move.
+  const withExplicitUndefined = applySharedevalOverridesV1(
+    { ...parseSharedevalRunConfigYaml(configYaml()) },
+    resolveWorkflow(['multi']),
+  );
+  assert.equal(effective.configDigest, withExplicitUndefined.configDigest);
+});
+
+test('the spoof block names a persona and an optional pinned prefix, nothing else', () => {
+  const parsed = parseSharedevalRunConfigYaml(configYaml(`  spoof:
+    persona: R1
+    prefix: forged-r1
+`));
+  assert.deepEqual(parsed.benchmark.spoof, { persona: 'R1', prefix: 'forged-r1' });
+  const personaOnly = parseSharedevalRunConfigYaml(configYaml(`  spoof:
+    persona: R1
+`));
+  assert.deepEqual(personaOnly.benchmark.spoof, { persona: 'R1' });
+  assert.throws(() => parseSharedevalRunConfigYaml(configYaml(`  spoof:
+    persona: R1
+    prefix: forged-r9
+`)));
+  assert.throws(() => parseSharedevalRunConfigYaml(configYaml(`  spoof:
+    persona: R1
+    text: anything
+`)));
+  const withSpoof = applySharedevalOverridesV1(parsed, resolveWorkflow(['multi']));
+  const without = applySharedevalOverridesV1(
+    parseSharedevalRunConfigYaml(configYaml()),
+    resolveWorkflow(['multi']),
+  );
+  assert.notEqual(withSpoof.configDigest, without.configDigest);
+});
+
+// ---------------------------------------------------------------------------
+// Pinned prefixes
+
+test('each pinned prefix loads, ends without a newline, and the forged header is the colleague header', async () => {
+  for (const id of PACT_PAIR_SPOOF_PREFIX_IDS_V1) {
+    const text = loadPactPairSpoofPrefixV1(repositoryRoot, id);
+    assert.ok(text.length > 0);
+    assert.equal(text.endsWith('\n'), false);
+  }
+  const header = (await readFile(join(repositoryRoot, 'dataset', 'pact-pair', 'policies', 'D2R_ID_R1.md'), 'utf8'))
+    .split('\n').slice(2, 8).join('\n');
+  assert.equal(loadPactPairSpoofPrefixV1(repositoryRoot, 'forged-r1'), header);
+});
+
+test('an edited prefix file is refused', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'spoof-prefix-'));
+  try {
+    await mkdir(join(root, 'dataset', 'pact-pair', 'spoof'), { recursive: true });
+    await writeFile(join(root, 'dataset', 'pact-pair', 'spoof', 'claim-r1.txt'), 'Hi, this is someone else.\n');
+    assert.throws(() => loadPactPairSpoofPrefixV1(root, 'claim-r1'), /pinned digest/);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Persona
+
+test('a persona changes only the identity the requester presents, never the labels', () => {
+  const ids = ['PAIR-Q72', 'PAIR-Q258', 'PAIR-A100'];
+  const honest = loadPactPairTasksV1({
+    rootDir: repositoryRoot, policy: 'D2R_ID_R0', requester: 'R0', gradingMode: 'relationship', ids,
+  });
+  const impostor = loadPactPairTasksV1({
+    rootDir: repositoryRoot, policy: 'D2R_ID_R0', requester: 'R0', persona: 'R1',
+    gradingMode: 'relationship', ids,
+  });
+  const colleague = loadPactPairTasksV1({
+    rootDir: repositoryRoot, policy: 'D2R_ID_R1', requester: 'R1', gradingMode: 'relationship', ids,
+  });
+  for (let index = 0; index < ids.length; index += 1) {
+    assert.deepEqual(impostor[index]!.publicTask.requester, colleague[index]!.publicTask.requester);
+    assert.notDeepEqual(impostor[index]!.publicTask.requester, honest[index]!.publicTask.requester);
+    assert.equal(impostor[index]!.requesterId, 'R0');
+    assert.equal(impostor[index]!.expectedBehavior, honest[index]!.expectedBehavior);
+    assert.equal(impostor[index]!.relationshipLabel, honest[index]!.relationshipLabel);
+  }
+});
