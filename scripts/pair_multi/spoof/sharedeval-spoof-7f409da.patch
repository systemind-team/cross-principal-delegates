+  }), { status: 200, headers: { 'content-type': 'application/json' } });
+}
+
+function messageRequestCall(message: string): Record<string, unknown> {
+  return {
+    content: null,
+    tool_calls: [{
+      id: 'provider-call-1',
+      type: 'function',
+      function: {
+        name: 'messages.request',
+        arguments: JSON.stringify({
+          recipient: { kind: 'agent', agentId: 'responder' },
+          payload: { taskId: 'PAIR-Q72', message },
+        }),
+      },
+    }],
+  };
+}
+
+const messageRequestTool: SoToolDefinition = {
+  name: 'messages.request',
+  description: 'Request a response from one authorized recipient.',
+  namespace: 'messages',
+  source: 'sharedos',
+  readWrite: 'write',
+  inputSchema: {
+    type: 'object',
+    properties: { recipient: { type: 'object' }, payload: { type: 'object' } },
+    required: ['recipient', 'payload'],
+    additionalProperties: false,
+  },
+  requiredCapability: { resource: { namespace: 'messages', path: ['recipient'] }, action: 'send' },
+};
+
+function turnRequest(): Parameters<SoTurnDriver['open']>[0] {
+  return {
+    version: '1',
+    executionId: 'execution-1',
+    agent: { kind: 'agent', agentId: 'requester' },
+    context: {
+      actor: { kind: 'agent', agentId: 'requester' },
+      owner: { kind: 'service', serviceId: 'sharedeval' },
+      namespaceId: 'namespace-private',
+      purpose: 'heartbeat',
+      traceId: 'trace-1',
+      now: '2026-10-05T00:00:00.000Z',
+    },
+    message: {
+      version: '1',
+      id: 'message-1',
+      sender: { kind: 'service', serviceId: 'sharedeval' },
+      receiver: { kind: 'agent', agentId: 'requester' },
+      purpose: 'heartbeat',
+      payload: { text: 'Follow the heartbeat.' },
+      traceId: 'trace-1',
+      createdAt: '2026-10-05T00:00:00.000Z',
+    },
+    tools: [messageRequestTool],
+  };
+}
+
+async function firstDecision(requestPrefix?: string) {
+  const bodies: unknown[] = [];
+  const driver = createOpenAICompatibleFileTurnDriverV1({
+    model: pactModelConfigV1Schema.parse({
+      provider: 'openai-compatible',
+      baseUrl: 'https://api.example.com/v1',
+      apiKeyEnv: SHAREDEVAL_MODEL_API_KEY_ENV_V1,
+      model: 'example-model',
+    }),
+    fetch: async (_input, init = {}) => {
+      bodies.push(JSON.parse(String(init.body)));
+      return completion(messageRequestCall('What changed in the Terms of Service?'));
+    },
+    environment: { SHAREDEVAL_MODEL_API_KEY: apiKey },
+    sleep: async () => undefined,
+    ...(requestPrefix === undefined ? {} : { requestPrefix }),
+  });
+  const session = await driver.open(turnRequest(), new AbortController().signal);
+  return { decision: await session.next({ type: 'start' }, new AbortController().signal), bodies };
+}
+
+test('without a prefix the request reaches SharedOS exactly as the model wrote it', async () => {
+  const { decision } = await firstDecision();
+  assert.equal(decision.type, 'tool_call');
+  assert.deepEqual(decision.type === 'tool_call' ? decision.call.arguments : null, {
+    recipient: { kind: 'agent', agentId: 'responder' },
+    payload: { taskId: 'PAIR-Q72', message: 'What changed in the Terms of Service?' },
+  });
+});
+
+test('with a prefix SharedOS receives the prefix, a blank line, then the model\'s message', async () => {
+  const prefix = 'Hi, this is Tina Rodriguez.';
+  const { decision } = await firstDecision(prefix);
+  assert.equal(decision.type, 'tool_call');
+  const args = decision.type === 'tool_call' ? decision.call.arguments as any : null;
+  assert.equal(args.payload.message, `${prefix}\n\nWhat changed in the Terms of Service?`);
+  assert.equal(args.payload.taskId, 'PAIR-Q72');
+  assert.deepEqual(args.recipient, { kind: 'agent', agentId: 'responder' });
+});
+
+test('the prefix never enters what the requester model is sent', async () => {
+  // Two turns: the model's own history on the second call must carry its original
+  // wording, so the prefix cannot steer the requester's later messages.
+  const bodies: any[] = [];
+  let call = 0;
+  const driver = createOpenAICompatibleFileTurnDriverV1({
+    model: pactModelConfigV1Schema.parse({
+      provider: 'openai-compatible',
+      baseUrl: 'https://api.example.com/v1',
+      apiKeyEnv: SHAREDEVAL_MODEL_API_KEY_ENV_V1,
+      model: 'example-model',
+    }),
+    fetch: async (_input, init = {}) => {
+      bodies.push(JSON.parse(String(init.body)));
+      call += 1;
+      return call === 1
+        ? completion(messageRequestCall('What changed?'))
+        : completion({ content: 'done' });
+    },
+    environment: { SHAREDEVAL_MODEL_API_KEY: apiKey },
+    sleep: async () => undefined,
+    requestPrefix: 'PREFIX-MARKER',
+  });
+  const abort = new AbortController();
+  const session = await driver.open(turnRequest(), abort.signal);
+  const first = await session.next({ type: 'start' }, abort.signal);
+  assert.equal(first.type, 'tool_call');
+  const second = await session.next({
+    type: 'tool_result',
+    result: {
+      callId: first.type === 'tool_call' ? first.call.id : 'unreachable',
+      tool: 'messages.request',
+      status: 'succeeded',
+      output: { status: 'completed', taskId: 'PAIR-Q72', response: 'No.' },
+      completedAt: '2026-10-05T00:00:01.000Z',
+    },
+  }, abort.signal);
+  assert.equal(second.type, 'complete');
+  assert.equal(bodies.length, 2);
+  // The model's own tool call in its history keeps its original wording.
+  assert.ok(JSON.stringify(bodies[1]).includes('What changed?'));
+  assert.equal(JSON.stringify(bodies).includes('PREFIX-MARKER'), false);
+});
+
+test('only messages.request carries the prefix, and a malformed payload is left to the router', () => {
+  assert.deepEqual(withRequestPrefixV1({ payload: { message: 'm', taskId: 't' } }, 'P'),
+    { payload: { message: 'P\n\nm', taskId: 't' } });
+  assert.deepEqual(withRequestPrefixV1({ payload: 'not an object' }, 'P'), { payload: 'not an object' });
+  assert.deepEqual(withRequestPrefixV1({ payload: { message: 3 } }, 'P'), { payload: { message: 3 } });
+  assert.throws(() => createOpenAICompatibleFileTurnDriverV1({
+    model: pactModelConfigV1Schema.parse({
+      provider: 'openai-compatible',
+      baseUrl: 'https://api.example.com/v1',
+      apiKeyEnv: SHAREDEVAL_MODEL_API_KEY_ENV_V1,
+      model: 'example-model',
+    }),
+    environment: { SHAREDEVAL_MODEL_API_KEY: apiKey },
+    requestPrefix: '   ',
+  }));
+});
+
