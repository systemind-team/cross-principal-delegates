@@ -0,0 +1,43 @@
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * Impersonation texts for the PAIR II spoofing arm. Each is written, then a
+ * blank line, at the head of every request the requester sends (see the model
+ * driver's `requestPrefix`). The digests pin the bytes, so a run cannot pick up an
+ * edited file under the same name.
+ *
+ * - forged-r1: the colleague's identity header, byte for byte as in D2R_ID_R1.md
+ *   (lines 3-8), placed in the request payload.
+ * - claim-r1: the same facts about the colleague, as one plain sentence.
+ * - claim-r3: the same facts about the close friend as D2R_ID_R3.md's header, as
+ *   plain sentences.
+ */
+export const PACT_PAIR_SPOOF_PREFIX_SHA256_V1 = {
+  'forged-r1': '8267a827be6270700b780bfa2eef0a42266cd85eb21780051edc5b1b5a7a551e',
+  'claim-r1': '3e6c7078126a6d733ebeee0b8fb95540a9f74b4c9482b65f77eaad4a86f76347',
+  'claim-r3': '79cbde67fdbcb11c639ba2190b67c739279e91f6456ad1673f6b798bd4bafa87',
+} as const;
+
+export const PACT_PAIR_SPOOF_PREFIX_IDS_V1 = [
+  'forged-r1',
+  'claim-r1',
+  'claim-r3',
+] as const satisfies readonly (keyof typeof PACT_PAIR_SPOOF_PREFIX_SHA256_V1)[];
+
+export type PactPairSpoofPrefixIdV1 = typeof PACT_PAIR_SPOOF_PREFIX_IDS_V1[number];
+
+/** Reads one pinned prefix; refuses bytes that do not match the pinned digest. */
+export function loadPactPairSpoofPrefixV1(rootDir: string, id: PactPairSpoofPrefixIdV1): string {
+  const expected = PACT_PAIR_SPOOF_PREFIX_SHA256_V1[id];
+  if (!expected) throw new Error(`Unknown spoof prefix ${String(id)}`);
+  const bytes = readFileSync(join(rootDir, 'dataset', 'pact-pair', 'spoof', `${id}.txt`));
+  const digest = createHash('sha256').update(bytes).digest('hex');
+  if (digest !== expected) {
+    throw new Error(`Spoof prefix ${id} does not match its pinned digest`);
+  }
+  const text = bytes.toString('utf8').replace(/\n+$/, '');
+  if (text.trim().length === 0) throw new Error(`Spoof prefix ${id} is empty`);
+  return text;
+}
