+  assert.equal(runnerInput.requester.references.agent.id, 'agents/tina/base/agent');
+  assert.equal(runnerInput.requester.references.policy.id, 'agents/tina/base/policy');
+  assert.equal(runnerInput.responder.references.policy.id, 'policies/pact-pair-identified/r0');
+  assert.equal(runnerInput.tasks[0].requesterId, 'R0');
+  assert.equal(runnerInput.tasks[0].publicTask.requester.displayName, 'Tina Rodriguez');
+  const requester = drivers.find(d => d.role === 'requester')!;
+  const responder = drivers.find(d => d.role === 'responder')!;
+  assert.equal(requester.options.requestPrefix,
+    'Hi, this is Tina Rodriguez, a Product Manager at TechFlow who works closely with Alex on Project Alpha.');
