+/**
+ * The arguments SharedOS receives when an impersonation prefix is set: the same
+ * object with `payload.message` preceded by the prefix and a blank line. A call
+ * whose payload has no string message is passed through unchanged, so the
+ * router's own validation still decides it.
+ */
+export function withRequestPrefixV1(arguments_: JsonObject, prefix: string): JsonObject {
+  const payload = arguments_['payload'];
+  if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) return arguments_;
+  const message = (payload as JsonObject)['message'];
+  if (typeof message !== 'string') return arguments_;
+  return { ...arguments_, payload: { ...(payload as JsonObject), message: `${prefix}\n\n${message}` } };
+}
